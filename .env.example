# ========================================================
# MAJASTIC SENTRY - ENVIRONMENT CONFIGURATION
# ========================================================

# 1. GitHub Integration (Guardrail Diff Checker)
# Dibutuhkan untuk memeriksa PR di repositori private Majastic secara live.
# Berikan permission read-only: 'repo' atau 'pull_requests:read'.
# Jika dikosongkan, sistem akan berjalan dalam mode simulasi cerdas.
GITHUB_PAT=

# 2. Supabase Integration (Persistent PostgreSQL Database)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Catatan): Jika Supabase dikosongkan, sistem otomatis berjalan dengan local memory fallback.
